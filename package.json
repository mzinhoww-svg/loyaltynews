{
  "name": "loyaltynews",
  "private": true,
  "version": "0.0.0",
  "description": "Loyalty News 2.1 — monorepo (npm workspaces). Ver DEVELOPMENT.md.",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev -w @ln/web",
    "build": "npm run build -w @ln/web",
    "start": "npm run start -w @ln/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm run typecheck -w @ln/web",
    "lint": "eslint .",
    "e2e": "npm run e2e -w @ln/web",
    "db:generate": "npm run generate -w @ln/db",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  }
}
