{
  "name": "@ln/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Loyalty News design system: tokens do brandkit + componentes React acessíveis. Dono: Frente 05 - LN UI/UX Director. Metadados ajustados ao monorepo na integracao (nome @ln/ui, TypeScript da raiz).",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles/index.css",
    "./tokens.css": "./src/tokens/tokens.css",
    "./tokens": "./src/tokens/tokens.ts"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "assets": "node scripts/build-logo-data.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "showcase": "vite --config showcase/vite.config.ts",
    "showcase:build": "vite build --config showcase/vite.config.ts"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "axe-core": "^4.14.1",
    "jsdom": "^31.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "vitest-axe": "^0.1.0"
  },
  "dependencies": {
    "@ln/contracts": "0.0.0"
  }
}
