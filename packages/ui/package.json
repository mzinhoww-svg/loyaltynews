{
  "name": "@ln/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Design system e tokens do brandkit + componentes React acessíveis (portal e LN Studio). Dono: Frente 05 — LN UI/UX Director.",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles/index.css",
    "./tokens.css": "./src/tokens/tokens.css",
    "./tokens": "./src/tokens/tokens.ts"
  },
  "types": "./src/index.ts",
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "assets": "node scripts/build-logo-data.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "showcase": "vite --config showcase/vite.config.ts",
    "showcase:build": "vite build --config showcase/vite.config.ts"
  },
  "dependencies": {
    "@ln/contracts": "0.0.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "axe-core": "4.14.1",
    "jsdom": "31.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vite": "8.3.8",
    "vitest-axe": "0.1.0"
  }
}
