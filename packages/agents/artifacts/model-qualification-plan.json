  "criterios": [
    {
      "id": "QC-SCHEMA",
      "text": "Saída dentro do contrato do perfil (R4-04)",
      "measure": "validateAgentOutput sobre cada saída",
      "threshold": "≥ 95% válidas na qualificação, 0 inválidas aceitas; operação monitora ≥ 99%",
      "proposed": true
    },
    {
      "id": "QC-USAGE",
      "text": "Cada chamada traz usage e evidência de geração (custo conciliável)",
      "measure": "sampleFromResponse != null e generation id presente",
      "threshold": "100% das chamadas",
      "proposed": false
    },
    {
      "id": "QC-COST",
      "text": "Custo real por chamada coerente com o preço de lista e nunca acima da reserva",
      "measure": "usage.cost (conciliado com /generation) x tokens × preço; custo ≤ teto da reserva",
      "threshold": "desvio ≤ 10% (esperado) e 0 chamadas acima da reserva",
      "proposed": true
    },
    {
      "id": "QC-ZDR",
      "text": "Endpoint de ZDR de fato usado",
      "measure": "provider.zdr=true na chamada e provider_name da geração ∈ endpoints ZDR listados do modelo",
      "threshold": "100% das chamadas",
      "proposed": false
    },
    {
      "id": "QC-CACHE-HIT",
      "text": "Cache de prompt funciona",
      "measure": "na 2ª chamada de cada par, prompt_tokens_details.cached_tokens > 0 e cache_read cobrado ao preço de leitura",
      "threshold": "cached_tokens > 0 em 5 de 5 pares por modelo; senão a rota para (cache_failure)",
      "proposed": false
    },
    {
      "id": "QC-DISTINCT-AUTHOR",
      "text": "Checagem em provedor distinto do redator",
      "measure": "autor = prefixo de generation.model da tentativa bem-sucedida (não o provedor de hospedagem)",
      "threshold": "100% dos pares com autor diferente; sem autor distinto: bloqueia",
      "proposed": false
    },
    {
      "id": "QC-DISTINCT-AUTHOR-GATE",
      "text": "Revisor do gate WF02 distinto do redator",
      "measure": "idem; Sonnet (Anthropic) nunca aprova o gate de rascunho Anthropic",
      "threshold": "100% dos revisores do gate com autor diferente",
      "proposed": false
    },
    {
      "id": "QC-SEEDED-RECALL",
      "text": "Detecta os erros plantados",
      "measure": "erros plantados apontados / erros plantados",
      "threshold": "≥ 90% e nenhum erro crítico (número, atribuição) perdido",
      "proposed": true
    },
    {
      "id": "QC-FALSE-POSITIVE",
      "text": "Não acusa erro em rascunho limpo",
      "measure": "rascunhos limpos com alerta / rascunhos limpos",
      "threshold": "≤ 20%",
      "proposed": true
    },
    {
      "id": "QC-QUALITY-DRAFT",
      "text": "Qualidade PT-BR da redação frente ao golden set",
      "measure": "avaliação cega por 2 editores com rubrica (fidelidade, clareza, ausência de cópia literal)",
      "threshold": "nota média ≥ referência acordada; limiar numérico a definir com a Editorial",
      "proposed": true
    },
    {
      "id": "QC-DECISION-SHAPE",
      "text": "Síntese respeita autoridade",
      "measure": "responsável inexistente → decisão rejeitada; decisão protegida → pending_verifier",
      "threshold": "100% dos casos de armadilha tratados",
      "proposed": true
    }
  ],
